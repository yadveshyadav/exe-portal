# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=super-secret-development-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=postgresql://portal_user:portal_password@localhost:5432/employee_portal_db
# For SQLite in local dev:
# DATABASE_URL=sqlite:///portal_dev.sqlite

# Redis Configuration (Real-time state & Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Agent Communication Security
AGENT_SHARED_SECRET=agent-enrollment-secret-key
HEARTBEAT_TIMEOUT_SECONDS=60
IDLE_THRESHOLD_SECONDS=300
